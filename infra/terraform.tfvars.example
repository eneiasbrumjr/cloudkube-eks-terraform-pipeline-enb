# New-cluster example. Copy to terraform.tfvars and review before applying.
# Existing environments require the staged migration in NETWORK_SECURITY.md.
# No AWS resources are created by the automatic repository checks.

project_name = "cloudkube-eks"
environment  = "dev"
aws_region   = "us-east-1"

vpc_cidr_block             = "10.0.0.0/16"
public_subnet_cidr_blocks  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidr_blocks = ["10.0.3.0/24", "10.0.4.0/24"]

# Private EC2, ECR API, ECR registry and STS endpoints plus S3 are always created.
# No general internet egress. Each interface service adds a charge per AZ/hour.
enable_nat_gateway = false
single_nat_gateway = true
# If enabling per-AZ NAT, public/private subnet counts must match.
enable_vpc_flow_logs = true

# Reviewed 2026-10-23. Check current regional availability before cloud planning.
# This is not a direct upgrade path from an older Kubernetes/AL2 cluster.
eks_cluster_version  = "1.36"
eks_desired_capacity = 2
eks_max_size         = 3
eks_min_size         = 1
# x86_64 types for AL2023. Root disks are encrypted gp3 in the launch template.
eks_instance_types = ["t3.medium", "t3a.medium"]
eks_disk_size      = 20

# Private access is required. Administration needs connectivity, DNS and IAM/RBAC.
cluster_endpoint_private_access = true
cluster_endpoint_public_access  = false
# Public opt-in additionally requires real trusted IPv4 egress CIDRs.
# Example documentation address only: ["203.0.113.10/32"]. Never use it as-is.
cluster_endpoint_public_access_cidrs = []
# Existing source SGs for private API administration; does not create a VPN/host.
eks_api_admin_security_group_ids = []

# Empty by default. Both a key and explicit source SGs are required to enable SSH.
eks_ssh_key_name                  = ""
eks_ssh_source_security_group_ids = []
# Adds SSM/SSM Messages endpoints and IAM. Verify the agent and any S3/log needs.
eks_enable_ssm = false

# Extra endpoint suffixes, e.g. ["logs"]. Check service availability and added cost.
eks_additional_interface_endpoint_services = []
# Default S3 endpoint policy only permits reading regional ECR image layers.
# Optional explicit bucket ARNs add GetObject only, not ListBucket or writes.
# This endpoint policy affects ALL clients using the private route tables.
eks_s3_read_bucket_arns = []

# Private ECR images are the baseline. Public registries/CDNs need a reviewed path.
# External TCP 443 needs both explicit CIDRs below AND enable_nat_gateway=true.
# NAT cannot bypass the more-specific regional S3 gateway route/policy.
eks_external_https_cidrs = []
# Control-plane TCP 443/10250 and DNS 53 are included; opt in to other webhook ports.
eks_control_plane_webhook_ports = []

enable_cluster_encryption = true
# Required by the installed EBS CSI controller; ordinary pods cannot rely on IMDS.
enable_irsa = true
# Spot capacity is interruptible; review workload availability before enabling.
enable_spot_instances = false

cluster_enabled_log_types           = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
create_cloudwatch_log_group         = true
cloudwatch_log_group_retention_days = 30

additional_tags = {
  Owner      = "DevOps Team"
  CostCenter = "Engineering"
}

# Cost example, not a total quote: 4 interface services x 2 AZs x 730 hours
# x USD 0.01/endpoint ENI-hour = USD 58.40, if that rate applies in your region.
# Optional SSM adds 2 services (USD 29.20 under the same assumptions).
# Add EKS, EC2, EBS, logs, KMS, data processing/transfer and any optional NAT.
# The S3 gateway endpoint has no endpoint hourly charge. See FINOPS_SECURITY.md
# and https://aws.amazon.com/privatelink/pricing/ for cost assumptions.
